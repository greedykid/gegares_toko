@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #1A365D
skinparam ActivityBackgroundColor #EBF8FF
skinparam ActivityDiamondBorderColor #2B6CB0
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM PELANGGAN - GEGARES**

|Pelanggan|
start
:Membuka Website Gegares;

|Sistem|
:Menampilkan Halaman Depan & Katalog Jajanan;

|Pelanggan|
if (Status Akun?) then (Belum Punya Akun)
  :Mengisi Form Registrasi;
  |Sistem|
  :Menyimpan Akun Baru;
else if (Lupa Password?) then (Lupa Password)
  :Mengisi Email Lupa Password;
  |Sistem|
  :Kirim Link Reset via Email & Update Password;
else (Sudah Akun)
  :Mengisi Form Login / Google Auth;
  |Sistem|
  :Validasi Credentials & Session;
  if (Hasil Validasi?) then (Gagal)
    :Menampilkan Pesan Error Login;
    stop
  else (Berhasil)
    :Menampilkan Halaman (Logged In);
  endif
endif

|Pelanggan|
split
  :Mencari Produk (Search Typo-Tolerant / Filter Kategori);
split again
  :Interaksi Chatbot AI Gemini (Tanya Produk / Snap & Buy Foto);
end split

|Sistem|
:Menampilkan Detail Produk / Respon AI Chatbot;

|Pelanggan|
:Menambah Produk ke Keranjang / Wishlist;

|Sistem|
:Update State Keranjang & Wishlist (Livewire);

|Pelanggan|
:Melakukan Checkout Pesanan;

|Sistem|
:Validasi Telepon & Tampilkan Form Checkout;

|Pelanggan|
:Pilih Alamat Pengiriman & Pilih Kurir;

|Sistem|
:Kalkulasi Ongkir Real-time via Biteship API;

|Pelanggan|
:Input Kupon Promo (Opsional) & Scan QRIS Pakasir;

|Sistem|
:Webhook Pakasir + Verifikasi Otoritatif API;
if (Status Pembayaran?) then (Gagal / Expired)
  :Status Order Pending / Cancelled;
  stop
else (Lunas / Paid)
  :Update Order Status = Paid;
  :Pengurangan Stok Atomik (DB Transaction);
  :Auto Booking Kurir via Biteship API;
endif

|Pelanggan|
:Lacak Pengiriman (Biteship Tracking) & Terima Pesanan;

|Sistem|
:Update Status Order = Completed;

|Pelanggan|
:Menulis Ulasan Produk (Rating, Teks & Foto);

|Sistem|
:Menyimpan Ulasan (Menunggu Moderasi Admin);

|Pelanggan|
:Mengklik Logout;

|Sistem|
:Destroy Session & Redirect Guest;

|Pelanggan|
stop
@enduml
