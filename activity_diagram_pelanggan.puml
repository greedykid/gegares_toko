@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #1A365D
skinparam ActivityBackgroundColor #EBF8FF
skinparam ActivityDiamondBorderColor #2B6CB0
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM PELANGGAN - GEGARES**

|Pelanggan|
start
:Membuka Website Gegares;

|Sistem|
:Menampilkan Halaman Utama & Katalog;

|Pelanggan|
if (Status Akun?) then (Belum Punya Akun)
  |Pelanggan|
  :Mengisi Form Pendaftaran;
  |Sistem|
  :Menyimpan Data Akun Baru;
else if (Lupa Password?) then (Lupa Password)
  |Pelanggan|
  :Mengisi Email Lupa Password;
  |Sistem|
  :Kirim Link Reset Email & Simpan Password Baru;
else (Sudah Punya Akun)
  |Pelanggan|
  :Mengisi Form Login / Login Google;
  |Sistem|
  :Validasi Data Login & Akun;
  if (Hasil Validasi Login?) then (Gagal)
    :Menampilkan Pesan Kesalahan Login;
    stop
  else (Berhasil)
    :Menyiapkan Session Akun (Logged In);
  endif
endif

|Sistem|
:Menampilkan Katalog Jajanan & Fitur AI;

|Pelanggan|
fork
  :Mencari Produk (Pencarian & Filter Kategori);
fork again
  :Menggunakan Asisten AI Gemini (Tanya / Snap Foto);
end fork

|Sistem|
:Menampilkan Detail Produk & Rekomendasi Jajanan;

|Pelanggan|
:Menambah Produk ke Keranjang / Wishlist;

|Sistem|
:Memperbarui Keranjang & Wishlist;

|Pelanggan|
:Melakukan Checkout Pesanan;

|Sistem|
:Menampilkan Form Checkout & Alamat;

|Pelanggan|
:Memilih Alamat Pengiriman & Kurir Pengiriman;

|Sistem|
:Menghitung Biaya Pengiriman Otomatis;

|Pelanggan|
:Masukkan Kode Promo (Opsional) & Lakukan Pembayaran Pakasir;

|Sistem|
:Verifikasi Pembayaran Pakasir;
if (Status Pembayaran?) then (Gagal / Belum Bayar)
  :Status Pesanan Dibatal / Menunggu;
  stop
else (Berhasil / Lunas)
  :Update Status Pesanan Menjadi Lunas;
  :Memperbarui Stok Produk;
  :Memproses Pengiriman Kurir;
endif

|Pelanggan|
:Memantau Pelacakan Pengiriman & Menerima Pesanan;

|Sistem|
:Update Status Pesanan Selesai;

|Pelanggan|
:Menulis Ulasan Produk (Rating, Teks & Foto);

|Sistem|
:Menyimpan Ulasan Pelanggan;

|Pelanggan|
:Mengklik Keluar (Logout);

|Sistem|
:Keluar dari Akun & Kembali ke Halaman Utama;

|Pelanggan|
stop
@enduml
