@startuml
skinparam dpi 200
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 13
skinparam ActivityFontSize 13
skinparam ActivityBorderColor #0284C7
skinparam ActivityBorderThickness 1.5
skinparam ActivityBackgroundColor #F0F9FF
skinparam ActivityDiamondBorderColor #CA8A04
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ActivityDiamondFontSize 12
skinparam ArrowColor #0F172A
skinparam ArrowThickness 1.5
skinparam SwimlaneTitleFontSize 16
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #94A3B8
skinparam SwimlaneBorderThickness 1.5
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM PELANGGAN - GEGARES**

|Pelanggan|
start
:Membuka Website Gegares;

|Sistem|
:Menampilkan Halaman Utama & Katalog Jajanan;

|Pelanggan|
if (Status Akun?) then (Belum Punya Akun)
  |Pelanggan|
  :Mengisi Form Pendaftaran;
  |Sistem|
  :Menyimpan Data Akun Baru;
else if (Lupa Password?) then (Lupa Password)
  |Pelanggan|
  :Mengisi Email Lupa Password;
  |Sistem|
  :Kirim Email Reset & Simpan Password Baru;
else (Sudah Punya Akun)
  |Pelanggan|
  :Mengisi Form Login / Login Google;
  |Sistem|
  :Validasi Data Login & Akun;
  if (Validasi Auth?) then (Gagal)
    :Menampilkan Pesan Error Login;
    stop
  else (Berhasil)
    :Menyiapkan Session Login Pengguna;
  endif
endif

|Sistem|
fork
  :Sinkronisasi Akun & Katalog Toko;
end fork

:Menampilkan Halaman Katalog & Rekomendasi;

|Pelanggan|
:Mencari & Memilih Jajanan Pasar (Pencarian / Filter Kategori);

|Sistem|
:Menampilkan Detail Produk & Varian;

|Pelanggan|
:Menambah Produk ke Keranjang / Wishlist;

|Sistem|
:Memperbarui Data Keranjang & Wishlist;

|Pelanggan|
:Melakukan Checkout Pesanan;

|Sistem|
:Menampilkan Form Checkout & Pilihan Alamat;

|Pelanggan|
:Memilih Alamat Pengiriman & Kurir Pengiriman;

|Sistem|
:Menghitung Biaya Pengiriman Otomatis;

|Pelanggan|
:Masukkan Kode Promo (Opsional) & Lakukan Pembayaran Pakasir;

|Sistem|
:Verifikasi Pembayaran Pakasir;
if (Status Pembayaran?) then (Gagal / Expired)
  :Status Pesanan Dibatal / Menunggu;
  stop
else (Berhasil / Lunas)
  :Update Status Pesanan Menjadi Lunas;
  :Memperbarui Stok Produk;
  :Memproses Pengiriman Kurir;
endif

|Pelanggan|
:Memantau Pelacakan Pengiriman & Menerima Pesanan;

|Sistem|
:Update Status Pesanan Selesai;

|Pelanggan|
:Menulis Ulasan Produk (Rating, Teks & Foto);

|Sistem|
:Menyimpan Ulasan Pelanggan;

|Pelanggan|
:Mengklik Keluar (Logout);

|Sistem|
:Keluar dari Akun & Kembali ke Halaman Utama;

|Pelanggan|
stop
@enduml
