@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #1A365D
skinparam ActivityBackgroundColor #EBF8FF
skinparam ActivityDiamondBorderColor #2B6CB0
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM PELANGGAN - GEGARES**

|Pelanggan|
start
:Membuka Halaman Website;

|Sistem|
:Menampilkan Halaman Depan (Homepage);

|Pelanggan|
if (Status Akun / Autentikasi?) then (Belum Punya Akun)
  :Mengklik Menu Daftar;
  |Sistem|
  :Menampilkan Form Pendaftaran;
  |Pelanggan|
  :Mengisi Form Registrasi;
  |Sistem|
  :Menyimpan Data Akun Baru & Logged In;
else if (Lupa Password?) then (Lupa Password)
  :Mengklik Lupa Password;
  |Sistem|
  :Menampilkan Form Lupa Password;
  |Pelanggan|
  :Mengisi Email Akun;
  |Sistem|
  :Mengirim Link Reset via Email;
  |Pelanggan|
  :Membuka Link Reset & Form Password Baru;
  |Sistem|
  :Memperbarui Password Database & Redirect Login;
else (Sudah Punya Akun)
  :Mengisi Form Login / Google Sign-In;
  |Sistem|
  :Validasi Credential / Token OAuth;
  if (Hasil Validasi?) then (Gagal / Salah)
    :Menampilkan Pesan Error Login;
    stop
  else (Berhasil)
    :Menampilkan Halaman Depan (Logged In);
  endif
endif

|Pelanggan|
:Mengeksplorasi Produk & Interaksi;
note right
  - Pencarian Typo-Tolerant
  - Filter Kategori
  - Chatbot AI (Gemini Grounding)
  - Snap & Buy (Foto Jajanan)
end note

:Menambah Produk ke Keranjang / Wishlist;

|Sistem|
:Update State Keranjang & Wishlist (Livewire);

|Pelanggan|
:Menekan Tombol Checkout;

|Sistem|
:Validasi Telepon & Menampilkan Form Checkout;

|Pelanggan|
:Memilih Alamat Pengiriman & Pilih Kurir;

|Sistem|
:Kalkulasi Ongkir Real-time via Biteship API;

|Pelanggan|
:Input Kode Promo (Opsional) & Buat Pesanan;

|Sistem|
:Generate Hosted Payment Link / QRIS Pakasir;

|Pelanggan|
:Scan & Bayar via QRIS Pakasir;

|Sistem|
:Webhook Pakasir + Verifikasi Otoritatif API;
if (Status Pembayaran?) then (Belum Bayar / Expired)
  :Status Order Pending / Cancelled;
  stop
else (Lunas / Paid)
  :Update Order Status = Paid;
  :Pengurangan Stok Atomik (DB Transaction);
  :Auto Booking Kurir via Biteship API;
endif

|Pelanggan|
:Memantau Pelacakan Pengiriman;

|Sistem|
:Menampilkan Status Resi & Biteship Tracking Real-time;

|Pelanggan|
:Menerima Pesanan & Konfirmasi Diterima;

|Sistem|
:Update Status Order = Completed;

|Pelanggan|
:Menulis Ulasan Produk (Rating, Teks & Foto);

|Sistem|
:Menyimpan Ulasan (Menunggu Moderasi Admin);

|Pelanggan|
:Mengklik Logout;

|Sistem|
:Destroy Session & Redirect Guest;

|Pelanggan|
stop
@enduml
