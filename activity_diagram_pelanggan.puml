@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #1A365D
skinparam ActivityBackgroundColor #EBF8FF
skinparam ActivityDiamondBorderColor #2B6CB0
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 260

title **ACTIVITY DIAGRAM PELANGGAN (SEDERHANA) - GEGARES**

|Pelanggan|
start
:Membuka Website Gegares;

|Sistem|
:Menampilkan Halaman Depan & Katalog;

|Pelanggan|
if (Sudah Login?) then (Belum)
  :Login / Registrasi Akun;
  |Sistem|
  :Validasi Akun & Set Session;
else (Ya)
endif

|Pelanggan|
:Cari / Pilih Jajanan Pasar (Katalog / AI Chatbot);

|Sistem|
:Menampilkan Detail Produk;

|Pelanggan|
:Tambah ke Keranjang & Checkout;

|Sistem|
:Hitung Ongkir (Biteship) & Tampilkan QRIS Pakasir;

|Pelanggan|
:Bayar Pesanan via QRIS Pakasir;

|Sistem|
:Verifikasi Webhook Pakasir & Update Status Paid;
if (Status Pembayaran?) then (Gagal / Expired)
  :Pesanan Dibatalkan;
  stop
else (Berhasil / Paid)
  :Kurangi Stok & Auto-Booking Kurir (Biteship);
endif

|Pelanggan|
:Lacak Pengiriman & Terima Pesanan;

|Sistem|
:Update Status Completed;

|Pelanggan|
:Beri Ulasan Produk (Opsional);

|Sistem|
:Simpan Ulasan Pelanggan;

|Pelanggan|
stop
@enduml
