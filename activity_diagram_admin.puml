@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #742A2A
skinparam ActivityBackgroundColor #FFF5F5
skinparam ActivityDiamondBorderColor #9B2C2C
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 260

title **ACTIVITY DIAGRAM ADMIN (SEDERHANA) - GEGARES**

|Admin|
start
:Membuka Halaman Login Admin (/admin/login);

|Sistem|
:Menampilkan Form Login Admin;

|Admin|
:Input Email & Password Admin;

|Sistem|
:Validasi Auth Admin (Middleware is_admin);
if (Validasi Auth?) then (Gagal)
  :Tampilkan Pesan Error Access Denied;
  stop
else (Berhasil)
  :Menampilkan Dashboard Panel Admin;
endif

|Admin|
:Pilih Operasi Manajemen Toko;
note right
  - Kelola Kategori & Produk
  - Kelola Promo / Kupon
  - Kelola Pesanan & Biteship
  - Moderasi Ulasan
  - Kelola User & Content Toko
end note

|Sistem|
:Menampilkan Halaman Manajemen & Simpan Changes ke Database;

|Admin|
:Logout Admin;

|Sistem|
:Destroy Admin Session & Redirect Login;

|Admin|
stop
@enduml
