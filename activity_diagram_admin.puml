@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #742A2A
skinparam ActivityBackgroundColor #FFF5F5
skinparam ActivityDiamondBorderColor #9B2C2C
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM ADMIN - GEGARES**

|Admin|
start
:Membuka Halaman Login Admin (/admin/login);

|Sistem|
:Menampilkan Form Login Admin;

|Admin|
:Mengisi Email & Password Admin;

|Sistem|
:Validasi Hak Akses Admin;
if (Hasil Validasi?) then (Gagal / Bukan Admin)
  :Menampilkan Pesan Akses Ditolak;
  stop
else (Berhasil / Admin Valid)
  :Menampilkan Halaman Dashboard Admin;
endif

|Admin|
split
  :Kelola Kategori Produk;
  |Sistem|
  :Menampilkan Halaman Kategori;
  :Menyimpan Data Kategori (Tambah/Edit/Hapus);

split again
  :Kelola Produk & Varian;
  |Sistem|
  :Menampilkan Halaman Produk;
  :Menyimpan Data Produk, Varian & Foto Galeri;

split again
  :Kelola Kode Promo / Kupon;
  |Sistem|
  :Menampilkan Halaman Kode Promo;
  :Menyimpan Data Kupon Diskon;

split again
  :Kelola Pesanan & Pengiriman;
  |Sistem|
  :Menampilkan Daftar Pesanan Toko;
  :Memperbarui Status Pesanan & Cetak Laporan;

split again
  :Moderasi Ulasan Pelanggan;
  |Sistem|
  :Menampilkan Daftar Ulasan Masuk;
  :Setujui / Tolak Ulasan & Perbarui Rating Produk;

split again
  :Kelola Data Pengguna;
  |Sistem|
  :Menampilkan Daftar Pengguna;
  :Menyimpan Data Pengguna & Hak Akses;

split again
  :Pengaturan Toko & Konten;
  |Sistem|
  :Menampilkan Halaman Pengaturan Toko;
  :Menyimpan Informasi Toko, Banner & Tampilan;
end split

|Admin|
:Mengklik Tombol Keluar (Logout);

|Sistem|
:Keluar dari Akun Admin & Kembali ke Form Login;

|Admin|
stop
@enduml
