@startuml
skinparam dpi 300
skinparam defaultFontName "Arial"
skinparam ActivityFontSize 13
skinparam ActivityBorderColor #742A2A
skinparam ActivityBackgroundColor #FFF5F5
skinparam ActivityDiamondBorderColor #9B2C2C
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 16
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #CBD5E0
skinparam SwimlaneWidth 350

title **ACTIVITY DIAGRAM ADMIN - GEGARES**

|Admin|
start
:Membuka Halaman Login Admin (/admin/login);

|Sistem|
:Menampilkan Halaman Form Login Admin;

|Admin|
:Mengisi Email & Password Admin;

|Sistem|
:Validasi Authentikasi & Middleware is_admin;
if (Validasi Auth Admin?) then (Gagal / bukan Admin)
  :Menampilkan Pesan Access Denied / Error;
  stop
else (Berhasil / Valid)
  :Menampilkan Dashboard Panel Admin;
endif

|Admin|
fork
  :Kelola Kategori Produk;
  |Sistem|
  :Menampilkan Halaman Manajemen Kategori;
  |Admin|
  :Tambah / Edit / Hapus Kategori & Toggle Status Aktif;
  |Sistem|
  :Update Database Kategori;

fork again
  :Kelola Produk & Varian;
  |Sistem|
  :Menampilkan Halaman Manajemen Produk;
  |Admin|
  :Tambah / Edit / Hapus Produk, Varian, Multi-Foto & Toggle Featured;
  |Sistem|
  :Update Database Produk & Galeri Image;

fork again
  :Kelola Kode Promo / Kupon;
  |Sistem|
  :Menampilkan Halaman Kelola Kode Promo;
  |Admin|
  :Tambah / Edit / Hapus Kupon (Fixed/Percent, Kuota, Tanggal);
  |Sistem|
  :Update Database Kupon;

fork again
  :Kelola Pesanan;
  |Sistem|
  :Menampilkan Halaman Manajemen Pesanan & Filter Periode;
  |Admin|
  :Lihat Detail Pesanan, Update Status, Manual Booking Biteship & Export CSV;
  |Sistem|
  :Update Status Pesanan & Generate File Export;

fork again
  :Moderasi Ulasan Pelanggan;
  |Sistem|
  :Menampilkan Halaman Kelola Ulasan (Pending Review);
  |Admin|
  :Setujui (Approve) atau Tolak (Reject/Hapus) Ulasan;
  |Sistem|
  :Update Status Approval & Recalculate Rating Produk;

fork again
  :Kelola Data Pengguna;
  |Sistem|
  :Menampilkan Halaman Manajemen Pengguna;
  |Admin|
  :Lihat Daftar User & Kelola Role / Status Akun;
  |Sistem|
  :Update Database Pengguna;

fork again
  :Pengaturan Toko & Konten Halaman;
  |Sistem|
  :Menampilkan Form Pengaturan Toko & Content Editor;
  |Admin|
  :Edit Alamat Toko (Biteship Origin), Hero Banner, FAQ, About, WA & Jam Ops;
  |Sistem|
  :Simpan Konfigurasi ke store_settings;
end fork

|Admin|
:Mengklik Tombol Logout Admin;

|Sistem|
:Invalidate Admin Session & Redirect ke Login Admin;

|Admin|
stop
@enduml
