@startuml
skinparam dpi 200
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 13
skinparam ActivityFontSize 13
skinparam ActivityBorderColor #E11D48
skinparam ActivityBorderThickness 1.5
skinparam ActivityBackgroundColor #FEF2F2
skinparam ActivityDiamondBorderColor #CA8A04
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ActivityDiamondFontSize 12
skinparam ArrowColor #0F172A
skinparam ArrowThickness 1.5
skinparam SwimlaneTitleFontSize 16
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #94A3B8
skinparam SwimlaneBorderThickness 1.5
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM ADMIN - GEGARES**

|Admin|
start
:Membuka Halaman Login Admin (/admin/login);

|Sistem|
:Menampilkan Form Login Admin;

|Admin|
:Mengisi Email & Password Admin;

|Sistem|
:Validasi Hak Akses Admin;
if (Hasil Validasi Auth?) then (Gagal / Bukan Admin)
  :Menampilkan Pesan Akses Ditolak;
  stop
else (Berhasil / Admin Valid)
  :Menampilkan Halaman Dashboard Admin;
endif

|Admin|
fork
  :Kelola Kategori Produk;
  |Sistem|
  :Menampilkan Halaman Kategori;
  :Menyimpan Data Kategori;
fork again
  |Admin|
  :Kelola Produk & Varian;
  |Sistem|
  :Menampilkan Halaman Produk;
  :Menyimpan Data Produk & Foto Galeri;
fork again
  |Admin|
  :Kelola Kode Promo / Kupon;
  |Sistem|
  :Menampilkan Halaman Kode Promo;
  :Menyimpan Data Kupon Diskon;
fork again
  |Admin|
  :Kelola Pesanan & Pengiriman;
  |Sistem|
  :Menampilkan Daftar Pesanan Toko;
  :Memperbarui Status & Cetak Laporan;
fork again
  |Admin|
  :Moderasi Ulasan Pelanggan;
  |Sistem|
  :Menampilkan Daftar Ulasan Masuk;
  :Perbarui Approval & Rating Produk;
fork again
  |Admin|
  :Kelola Data Pengguna;
  |Sistem|
  :Menampilkan Daftar Pengguna;
  :Menyimpan Data Pengguna & Hak Akses;
fork again
  |Admin|
  :Pengaturan Toko & Konten;
  |Sistem|
  :Menampilkan Form Pengaturan Toko;
  :Menyimpan Informasi & Tampilan Toko;
end fork

|Admin|
:Mengklik Tombol Keluar (Logout);

|Sistem|
:Keluar dari Akun Admin & Kembali ke Form Login;

|Admin|
stop
@enduml
