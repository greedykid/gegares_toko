@startuml
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #742A2A
skinparam ActivityBackgroundColor #FFF5F5
skinparam ActivityDiamondBorderColor #9B2C2C
skinparam ActivityDiamondBackgroundColor #FEFCBF
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #A0AEC0
skinparam SwimlaneWidth 280

title **ACTIVITY DIAGRAM ADMIN - GEGARES**

|Admin|
start
:Membuka Halaman Login Admin (/admin/login);

|Sistem|
:Menampilkan Form Login Admin;

|Admin|
:Mengisi Email & Password Admin;

|Sistem|
:Validasi Authentikasi & Middleware is_admin;
if (Hasil Validasi Auth?) then (Gagal / Bukan Admin)
  :Menampilkan Pesan Access Denied / Error;
  stop
else (Berhasil / Valid Admin)
  :Menampilkan Dashboard Panel Admin;
endif

|Admin|
:Mengakses Menu Manajemen Toko;
note right
  Dashboard Admin memberikan akses ke
  7 modul utama manajemen operasional
end note

:Kelola Kategori Produk;
|Sistem|
:Menampilkan Halaman Manajemen Kategori;
:Update Database Kategori (Tambah/Edit/Hapus/Status);

|Admin|
:Kelola Produk & Varian;
|Sistem|
:Menampilkan Halaman Manajemen Produk;
:Update Database Produk, Varian & Galeri Foto;

|Admin|
:Kelola Kode Promo / Kupon;
|Sistem|
:Menampilkan Halaman Kelola Kode Promo;
:Update Database Kupon (Diskon/Kuota/Masa Berlaku);

|Admin|
:Kelola Pesanan & Pengiriman;
|Sistem|
:Menampilkan Halaman Manajemen Pesanan & Filter Periode;
:Update Status Order, Booking Biteship & Export CSV;

|Admin|
:Moderasi Ulasan Pelanggan;
|Sistem|
:Menampilkan Halaman Kelola Ulasan (Pending Review);
:Update Approval Status & Recalculate Rating Produk;

|Admin|
:Kelola Data Pengguna;
|Sistem|
:Menampilkan Halaman Manajemen Pengguna;
:Update Database User & Pengaturan Role;

|Admin|
:Pengaturan Toko & Konten Halaman;
|Sistem|
:Menampilkan Form Pengaturan Toko & Content Editor;
:Simpan Konfigurasi ke store_settings (Alamat, Hero, FAQ, About);

|Admin|
:Mengklik Tombol Logout Admin;

|Sistem|
:Invalidate Admin Session & Redirect ke Form Login Admin;

|Admin|
stop
@enduml
